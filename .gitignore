# 构建产物（CI 生成，不提交）；模板文件保留
blog/**/*.html
!blog/template.html
blog/home/home/index.html

# 文章参考论文 PDF（仅保留在本地）
/blog/articles/**/*.[pP][dD][fF]

# Generated homepage recent-posts fragment (built locally and in CI)
/recent-posts.generated.html

# Local Markdown render cache (recreated automatically)
/.cache/blog-renderer/

# 渲染器依赖（submodule 内）
tools/blog-renderer/node_modules/
tools/blog-renderer/coverage/

# 系统
.DS_Store
